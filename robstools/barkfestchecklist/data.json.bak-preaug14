      "id": "t11",
      "title": "TV setup — floor stand + laptop shelf",
      "group": "media",
      "taskStatus": "okay",
      "orderStatus": "okay",
      "artStatus": "na",
      "order": [
        {
          "t": "HDMI cable (long)",
